<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ruler_s_Fate</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Exclui a subpasta Testes/ para que o compilador não confunda
       os arquivos xUnit com código do projeto principal. -->
  <ItemGroup>
    <Compile Remove="Testes\**" />
    <EmbeddedResource Remove="Testes\**" />
    <None Remove="Testes\**" />
  </ItemGroup>

</Project>
